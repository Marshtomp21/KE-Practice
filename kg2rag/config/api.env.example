# KG²RAG API-adapted reproduction configuration.
# Copy this file to `api.env` and fill in your own keys. Do not commit api.env.

# Generator and triple extractor: DeepSeek OpenAI-compatible Chat Completions API.
REPRO_LLM_API_KEY=
REPRO_LLM_ENDPOINT=https://api.deepseek.com/chat/completions
REPRO_LLM_MODEL=deepseek-v4-flash

# Retrieval embeddings. SiliconFlow is an example provider; replace all three
# values together if you use another OpenAI-compatible embedding provider.
REPRO_EMBED_API_KEY=
REPRO_EMBED_ENDPOINT=https://api.siliconflow.cn/v1/embeddings
REPRO_EMBED_MODEL=BAAI/bge-m3

# Graph-aware candidate reranking. This endpoint is optional for a dry run but
# required for the complete API-adapted KG²RAG pipeline.
REPRO_RERANK_API_KEY=
REPRO_RERANK_ENDPOINT=https://api.siliconflow.cn/v1/rerank
REPRO_RERANK_MODEL=BAAI/bge-reranker-v2-m3
