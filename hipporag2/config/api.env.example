# HippoRAG 2 API configuration. Copy to api.env locally; never commit it.
#
# The upstream OpenAI-compatible adapters normally read one shared environment
# key. The reproduction runner injects separate credentials because DeepSeek
# and SiliconFlow are distinct providers.

HIPPO_LLM_API_KEY=
HIPPO_LLM_BASE_URL=https://api.deepseek.com/v1
HIPPO_LLM_MODEL=deepseek-v4-flash

HIPPO_EMBED_API_KEY=
HIPPO_EMBED_BASE_URL=https://api.siliconflow.cn/v1
HIPPO_EMBED_MODEL=BAAI/bge-m3
