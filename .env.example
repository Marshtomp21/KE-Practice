# 复制为 .env 或直接 export 到环境变量。
# 密钥只从环境变量读取，settings.yaml 里只写变量名，不写密钥本身。
#
# 不配置也能跑：抽取会走规则通道，生成会走结构化通道，向量走本地哈希 embedder，
# 全流程零外部依赖。配置之后自动切换到模型通道。

# 抽取与生成用的对话模型（OpenAI 兼容接口）
GRAPHRAG_LLM_KEY=

# 向量化模型；同时需要把 settings.yaml 的 embedding.provider 改成 remote
GRAPHRAG_EMBED_KEY=

# neo4j-graphrag 库基线使用的数据库。数据库中需预先存在 Chunk 向量索引与图关系。
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
